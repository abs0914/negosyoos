# Safe for the browser. Prefer Supabase's sb_publishable_ key format.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only operational settings.
APP_URL=http://127.0.0.1:3000
APP_ENV=development
LOG_LEVEL=info

# Server-only PayMongo hosted checkout. Use test keys first; never add NEXT_PUBLIC_.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Only enable methods approved for your PayMongo account: qrph,card,gcash,paymaya,grab_pay
PAYMONGO_PAYMENT_METHODS=qrph
